      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="32" value="• High Availability (99.99% uptime)&#xa;• Low Latency video start (&lt; 2 sec)&#xa;• Smooth streaming (no buffering)&#xa;• Scalable to millions of users&#xa;• Secure content (no piracy)&#xa;• Works on all devices" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="590" y="260" width="360" height="120" as="geometry" />
    </mxCell>

    <!-- ==================== ASSUMPTIONS ==================== -->
    <mxCell id="40" value="Assumptions" style="text;html=1;fontSize=15;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="40" y="430" width="200" height="40" as="geometry" />
    </mxCell>
    <mxCell id="41" value="• 200 million users worldwide&#xa;• 100 million streams per day&#xa;• Average video size = 5 GB (per hour, HD)&#xa;• Read : Write ratio = 1000 : 1 (mostly watching, rarely uploading)&#xa;• Videos stored in multiple qualities: 360p, 720p, 1080p, 4K" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="40" y="480" width="480" height="110" as="geometry" />
    </mxCell>

    <!-- ==================== CAPACITY ESTIMATION ==================== -->
