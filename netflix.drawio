    <mxCell id="53" value="CDN saves bandwidth by serving video from servers closest to the user — no need to go to origin every time." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
