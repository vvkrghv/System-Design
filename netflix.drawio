    <mxCell id="51" value="Storage&#xa;&#xa;100M streams x 5GB&#xa;= 500 PB total video" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="560" y="480" width="170" height="80" as="geometry" />
