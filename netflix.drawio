    </mxCell>

    <!-- NON-FUNCTIONAL REQUIREMENTS -->
    <mxCell id="30" value="Non-Functional Requirements" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
