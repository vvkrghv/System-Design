    <mxCell id="22" value="• User sign up / login&#xa;• Browse movies and shows&#xa;• Search content&#xa;• Stream video (play / pause / seek)&#xa;• Resume where you left off&#xa;• Multiple user profiles" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
