    <mxCell id="52" value="Bandwidth&#xa;&#xa;100M streams x 5 Mbps&#xa;= 500 Tbps peak" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="750" y="480" width="180" height="80" as="geometry" />
